          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"answerId\": \"{{answerTrueId}}\",\n  \"scoreContribution\": 1.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionAndAnswers/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionAndAnswers", "create"]
            }
          }
        },
