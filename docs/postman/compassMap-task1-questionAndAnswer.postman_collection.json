        {
          "name": "09 · Q&A · update score only (partial update)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('scoreContribution was updated', () => pm.expect(body.scoreContribution).to.eql(4.5));",
                  "pm.test('relations were NOT nulled by the partial update', () => {",
                  "  pm.expect(body.question.id).to.eql(pm.collectionVariables.get('questionId'));",
                  "  pm.expect(body.answer.id).to.eql(pm.collectionVariables.get('answerTrueId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{qaId}}\",\n  \"scoreContribution\": 4.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionAndAnswers/update",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionAndAnswers", "update"]
            }
          }
        },
        {
          "name": "10 · Q&A · second row reusing the same Answer (proves n..1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('it is a different Q&A row', () => pm.expect(body.id).to.not.eql(pm.collectionVariables.get('qaId')));",
                  "pm.test('it reuses the same answer_id', () => pm.expect(body.answer.id).to.eql(pm.collectionVariables.get('answerTrueId')));",
                  "pm.collectionVariables.set('qa2Id', body.id);"
                ]
              }
            }
