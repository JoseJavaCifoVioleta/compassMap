            "url": {
              "raw": "{{baseUrl}}/api/v1/answers/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "answers", "create"]
            }
          }
        },
        {
          "name": "03 · Question · create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('question has a generated id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.test('name is derived from order', () => pm.expect(body.name).to.eql('q-101'));",
                  "pm.collectionVariables.set('questionId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Do you know what a JPA relationship is?\",\n  \"dimension\": \"KNOWS_CODE\",\n  \"order\": 101,\n  \"weight\": 1.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "create"]
            }
          }
        },
        {
          "name": "04 · Q&A · create (question + answer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Q&A has a generated id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.test('FK question_id points to the created question', () => pm.expect(body.question.id).to.eql(pm.collectionVariables.get('questionId')));",
                  "pm.test('FK answer_id points to the created answer', () => pm.expect(body.answer.id).to.eql(pm.collectionVariables.get('answerTrueId')));",
                  "pm.test('scoreContribution is persisted', () => pm.expect(body.scoreContribution).to.eql(2.5));",
                  "pm.collectionVariables.set('qaId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"answerId\": \"{{answerTrueId}}\",\n  \"scoreContribution\": 2.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionAndAnswers/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionAndAnswers", "create"]
            }
          }
        },
        {
          "name": "05 · Q&A · get by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('id matches', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('qaId')));",
                  "pm.test('question is loaded through the FK', () => pm.expect(body.question.id).to.eql(pm.collectionVariables.get('questionId')));",
                  "pm.test('answer is loaded through the FK', () => pm.expect(body.answer.id).to.eql(pm.collectionVariables.get('answerTrueId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionAndAnswers/byId?id={{qaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionAndAnswers", "byId"],
              "query": [{ "key": "id", "value": "{{qaId}}" }]
            }
          }
        },
        {
          "name": "06 · Q&A · get all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
