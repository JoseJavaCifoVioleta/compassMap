    "name": "compassMap · Task 1 · QuestionAndAnswer",
    "description": "Task 1 — QuestionAndAnswer as an @Entity linked to Question and Answer via @ManyToOne.\n\nHow to use it:\n1. Start the Spring Boot app (port 8080 by default).\n2. Import this collection in Postman.\n3. Run the folder 'Task 1 — QuestionAndAnswer' with the Collection Runner, IN ORDER (the requests save ids in collection variables).\n\nThe collection covers the happy path (create question, create answers, create Q&A, read, update, delete) and two negative cases (400 unknown question / missing answer id) plus a 404 after delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "questionId",
      "value": ""
    },
    {
      "key": "answerTrueId",
      "value": ""
    },
    {
      "key": "answerFalseId",
      "value": ""
    },
    {
      "key": "qaId",
      "value": ""
    },
    {
      "key": "qa2Id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Task 1 — QuestionAndAnswer",
      "item": [
        {
          "name": "00 · Context · questions count",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('count is a number', () => pm.expect(pm.response.json()).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questions/count",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questions", "count"]
            }
          }
        },
        {
          "name": "01 · Answer · create TRUE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('answer has a generated id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.test('answer value is true', () => pm.expect(body.value).to.eql(true));",
                  "pm.collectionVariables.set('answerTrueId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/answers/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "answers", "create"]
            }
          }
        },
        {
          "name": "02 · Answer · create FALSE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('answer value is false', () => pm.expect(body.value).to.eql(false));",
                  "pm.collectionVariables.set('answerFalseId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
