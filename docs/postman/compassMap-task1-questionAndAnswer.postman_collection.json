                  "pm.test('contains the created Q&A', () => pm.expect(body.map(qa => qa.id)).to.include(pm.collectionVariables.get('qaId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/questionAndAnswers/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "questionAndAnswers", "all"]
